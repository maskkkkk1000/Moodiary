    <string name="ui_each_recorded_source_day_counts_once_only_the_immediately_fo" formatted="false">Each recorded source day counts once. Only the immediately following recorded calendar day is used. Both days must be inside the range. Missing days are excluded, not treated as neutral moods.</string>
